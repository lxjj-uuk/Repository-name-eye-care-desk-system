        {
            "label": "deveco: run debug server - hi3861",
            "detail": "deveco: autogenerated",
            "problemMatcher": {
                "pattern": {
                    "regexp": "^.*$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*Debug\\sServer\\sConnected*",
                    "endsPattern": "^.*Listening\\son\\sTCP/IP\\sport.*"
                }
            },
            "command": "D:\\DevEco-Device-Tool\\core\\deveco-venv\\Scripts\\hos.exe",
            "args": [
                "debug",
                "--interface=server",
                "--environment=hi3861",
                "--client-port=${command:deveco-device-tool.getDebugRemotePort}"
            ],
            "isBackground": true
        }
    ],
    "options": {
