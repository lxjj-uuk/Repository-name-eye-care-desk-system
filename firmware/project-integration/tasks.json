{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Hi3861: Build",
            "detail": "Use hos.exe to build the current Hi3861 project",
            "type": "shell",
            "command": "D:\\DevEco-Device-Tool\\core\\deveco-venv\\Scripts\\hos.exe",
            "args": [
                "run",
                "--project-dir",
                "${workspaceFolder}",
                "--environment",
                "hi3861"
            ],
            "options": {
                "env": {
                    "USERPROFILE": "D:\\DevEco-Device-Tool\\userprofile"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Hi3861: Flash",
            "detail": "Flash the allinone image with Java HiBurn; press RST when prompted",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\flash-hi3861.ps1"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Hi3861: Build & Flash",
            "detail": "Build, then flash; press RST when BootromDownloadBoot appears",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Hi3861: Build",
                "Hi3861: Flash"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Hi3861: Monitor",
            "detail": "Auto-detect the active CH340 port and print serial output",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\monitor-hi3861.ps1"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
